a.nw{text-decoration:none;color:inherit}
a.nw em{font-style:normal}

/* ---- Hinweis für Gäste: Miniatur mit dem Band unten am Bildschirm, wie auf der Website (Pille in Wandholz) ---- */
.mini{position:relative}
#h-probe{position:absolute;z-index:2;left:0;right:0;bottom:14px;padding:0 16px}
.mini__band{display:flex;align-items:center;gap:12px;max-width:560px;margin:0 auto;padding:11px 12px 11px 16px!important;border-radius:999px;text-align:left;box-shadow:inset 0 0 0 1px rgba(243,205,148,.22),0 18px 30px -18px rgba(0,0,0,.8)}
.mini__band>span{flex:1;min-width:0}
.mini__band>b{flex:none;width:26px;height:26px;border-radius:50%;display:grid;place-items:center;font:400 14px/1 var(--sans);box-shadow:inset 0 0 0 1px currentColor;opacity:.7}
.mini__dr{flex:none;width:11px;height:11px;border:1.4px solid;border-radius:50%;opacity:.9}
.mini__band u{color:var(--lk,#f3cd94)}
.mini__band.aus{opacity:1!important}

/* ---- Knopf «Website ansehen» im Kopf: Kerzenlicht mit Knauf, wie die Knöpfe des Hauses ---- */
.kn--glanz{--o:#fbe7c6!important;--m:#f3cd94!important;--u:#8a5f2c!important;--t:#2a1a0e!important;--licht:rgba(255,255,255,.85)!important}
.kn.kn--glanz{color:#2a1a0e}

/* Kleine Handys, 320 px (Fund Carlton F45): Filter brechen um, Zwischentitel als Block */
@media (max-width:420px){.wahl2{display:flex;flex-wrap:wrap;max-width:100%}.wahl2 button{padding:9px 10px;letter-spacing:.08em}h2.zw{display:block;font-size:25px}h2.zw::before{display:inline-block;vertical-align:-.05em;margin-right:10px}h2.zw::after{display:none}.kh{flex-wrap:wrap;gap:12px}.kh__b{width:64px!important;height:48px!important}.kh h3{hyphens:auto;overflow-wrap:anywhere}.kh .kn{flex:none}.bereiche .bk__n b{font-size:17px}}
/* Handy: das Zeichen des Hauses bleibt im Kopf (die Vorlage blendet am Handy die Schrift der Marke aus, das Zeichen steht in einem span) */
#kopf .kopf__marke>.kopf__z{display:grid}
/* Drei Reiter (Texte, Fotos, Listen) passen nebeneinander in die Spalte der Stellen */
.stellen__w button{padding:9px 7px!important;letter-spacing:.1em!important;gap:6px}
.stellen__w button svg{width:13px;height:13px}
/* Gelasio fett für Titel: lange Titel der Gruppen brechen um statt abgeschnitten, das Schreibfeld in der Schrift des Fliesstexts der Website (Instrument Sans) */
.gr>summary b{font-size:17.5px;line-height:1.22;white-space:normal;overflow:visible;text-overflow:clip;display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;overflow:hidden}
.gr>summary small{flex:none}
.ed__f{font:400 16.5px/1.5 var(--sans)}
.zl .ed__f{font-size:15.5px}
.suche input,.suche input::placeholder{font:400 15px/1.3 var(--sans);font-style:normal}
.fz input,.fz textarea,.feld input,.feld textarea,.ue__sp input,.ed--angabe input{font:400 16px/1.4 var(--sans)}
.feld input::placeholder,.feld textarea::placeholder,.fz input::placeholder,.ue__sp input::placeholder{font-style:normal}
.stellen__w button{letter-spacing:.05em!important;font-size:9.5px!important;padding:9px 5px!important}
/* Titel in Gelasio fett wie die Wortmarke des Hauses (Georgia Bold → Gelasio 700, assets/css/main.css); Gelasio fett läuft breiter, deshalb etwas kleiner */
.kopf__titel,.titel h1,h2.zw,.karte h3,.lg b,.ag b,.mck b,.leer-hinweis b,.fenster h2,.start-tuer h1,.ab b,.mini__t b,.kt b,.ue-weg__s b,.quit b,.leiste__t b,.vl b,.gr>summary b{font-weight:700}
.titel.buehne h1{font-size:clamp(38px,3.9vw,62px)}
.titel--knapp.buehne h1{font-size:clamp(34px,3.3vw,52px)}
h2.zw{font-size:28px}
.fenster h2{font-size:36px}
/* Zeiten & Preise: Zeile aus einer Karte oder Liste des Hauses, nur zum Ansehen, der Knopf führt zur Liste (Ruedihus 17.10.2026) */
.zl--liste .zl__t{display:block;padding:8px 10px;font:400 15.5px/1.4 var(--sans);color:var(--tinte)}

/* Ruedihus Kacheln ruhig (Robert 18.10.2026, M21): kein Kippen, kein Sprung, die Kachel hebt sich langsam wenige Pixel, Fotos zoomen kaum */
@media (hover:hover){
.bk,.bereiche .bk{transition:transform 1s cubic-bezier(.22,1,.36,1),box-shadow 1s cubic-bezier(.22,1,.36,1)!important}
.bk:hover,.bereiche .bk:hover{transform:translateY(-3px)!important}
.bk__b img,.fr__b img,.ag__b img{transition:transform 1.4s cubic-bezier(.22,1,.36,1)!important}
.bk:hover .bk__b img,.fr:hover .fr__b img,.ag--foto:hover .ag__b img{transform:scale(1.02)!important}
.mck:hover .mbuch__d{transform:rotateY(-24deg) rotateX(6deg) translateY(-3px)!important}
.kt:hover .kt__b{transform:rotate(var(--r,0deg)) translateY(-3px)!important}
}

/* Robert 18.10.2026 23:32: der Glanz beim Überfahren bleibt in der Knopf-Form, kein Balken links und rechts */
.kn{overflow:hidden}
